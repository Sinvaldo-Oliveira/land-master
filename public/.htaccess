# Fallback de SPA para a Hostinger (Apache): rotas como /admin/site devolvem o index.html,
# e o React Router resolve a rota no navegador. Arquivos e pastas reais são servidos normalmente.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
